[Unit]
Description=OKAL localhost HTTPS proxy
After=network.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=okal-local-proxy
StateDirectoryMode=0700
ExecStart=/usr/bin/caddy run --config /etc/okal/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
Environment=XDG_DATA_HOME=/var/lib/okal-local-proxy
Environment=XDG_CONFIG_HOME=/var/lib/okal-local-proxy

[Install]
WantedBy=multi-user.target
