{
    admin off
    persist_config off
}

# Private only: no DNS ACME, external sockets or Cloudflare activation.
http://okal {
    bind 127.0.0.1
    redir https://okal{uri} 308
}

https://okal {
    bind 127.0.0.1
    tls internal
    reverse_proxy 127.0.0.1:8766 {
        header_up -X-Forwarded-Host
        header_up -X-Forwarded-Proto
        header_up -X-Forwarded-For
        header_up -X-Real-IP
    }
}
