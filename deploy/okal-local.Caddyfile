{
    admin off
    persist_config off
    auto_https disable_redirects
}

# HTTPS-only private hostname, local self-hosted CA. Never listens on LAN.
https://okal {
    bind 127.0.0.1
    tls internal
    reverse_proxy 127.0.0.1:8766
}

# Only an HTTP redirect is served on local port 80.
http://okal {
    bind 127.0.0.1
    redir https://okal{uri} 308
}
